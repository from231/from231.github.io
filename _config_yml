# Site Configuration for From 231 Newsletter
title: From 231
description: Your weekly companion for all things Whitecaps FC, straight from Section 231
logo: "/assets/images/from231-logo.png"
baseurl: ""
url: "https://from231.github.io"

# Theme configuration
theme: just-the-docs
color_scheme: whitecaps

# Footer content
footer_content: "Copyright &copy; 2025 From 231. Powered by <a href=\"https://buttondown.com\">Buttondown</a>."

# Back to top link
back_to_top: true
back_to_top_text: "Back to top"

# Footer last edited timestamp
last_edit_timestamp: true
last_edit_time_format: "%b %e %Y at %I:%M %p"

# Aux links for the upper right navigation
aux_links:
  "Newsletter Archive":
    - "https://buttondown.com/from231/archive/"
  "Whitecaps FC":
    - "https://www.whitecapsfc.com"

# Makes Aux links open in a new tab
aux_links_new_tab: true

# Enable search
search_enabled: true
search:
  heading_level: 2
  previews: 3
  preview_words_before: 5
  preview_words_after: 10
  tokenizer_separator: /[\s/]+/
  rel_url: true
  button: false

# Enable heading anchors
heading_anchors: true

# Configure footer "Edit this page" link
gh_edit_link: false

# Configure callouts
callouts:
  highlight:
    color: blue
  important:
    title: Match Day
    color: red
  note:
    title: Note
    color: grey-lt
